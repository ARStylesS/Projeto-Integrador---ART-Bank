generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                      String          @id @default(uuid())
  usuario                 String?         
  nome                    String
  email                   String          @unique
  telefone                String?         
  celular                 String          @default("") 
  senhaUsuario            String
  saldo                   Decimal         @db.Decimal(10, 2)
  agencia                 String          @default("0001") 
  conta                   String          @unique          
  fichas                  Int             @default(0)
  genero                  String          @default("M") 
  fotoUrl                 String?         
  criadoEm                DateTime        @default(now())
  transferenciasRecebidas Transferencia[] @relation("Destinatario")
  transferenciasEnviadas  Transferencia[] @relation("Remetente")
  solicitacoes            Solicitacao[]
  emprestimos             Emprestimo[] 
  
  cartoes                 Cartao[]

  @@map("usuarios")
}

model Cartao {
  id        String   @id @default(uuid())
  numero    String
  bandeira  String
  tipo      String   // 'Débito' | 'Crédito' | 'Débito / Crédito'
  usuarioId String
  criadoEm  DateTime @default(now())

  // Configura o CASCADE para excluir os cartões automaticamente se o usuário deletar a conta
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("cartoes")
}

model Transferencia {
  id              String   @id @default(uuid())
  valor           Decimal  @db.Decimal(10, 2)
  remetenteId     String
  destinatarioId  String
  dataTransacao   DateTime @default(now())
  dataRecebimento DateTime
  status          String   @default("CONCLUIDO")
  destinatario    Usuario  @relation("Destinatario", fields: [destinatarioId], references: [id])
  remetente       Usuario  @relation("Remetente", fields: [remetenteId], references: [id])

  @@map("transferencias")
}

model Solicitacao {
  id            String   @id @default(uuid())
  codigo        String   @unique
  solicitanteId String
  valor         Decimal  @db.Decimal(10, 2)
  status        String   @default("PENDENTE")
  criadoEm      DateTime @default(now())
  expiradoEm    DateTime
  solicitante   Usuario  @relation(fields: [solicitanteId], references: [id])

  @@map("solicitacoes")
}

model Emprestimo {
  id            String   @id @default(uuid())
  usuarioId     String
  valor         Decimal  @db.Decimal(10, 2)
  parcelas      Int
  taxaMensal    Decimal  @db.Decimal(5, 4)
  valorParcela  Decimal  @db.Decimal(10, 2)
  montanteFinal Decimal  @db.Decimal(10, 2)
  status        String   @default("ATIVO")
  criadoEm      DateTime @default(now())
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])

  @@map("emprestimos")
}